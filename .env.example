# Copy to .env for local runs. On Render set these in the dashboard (Environment).
BOT_TOKEN=123456:telegram-token-from-BotFather
DATABASE_URL=postgresql://user:password@host:5432/postgres
GEMINI_API_KEY=your-key-from-aistudio.google.com
ADMIN_IDS=111111111
CARD_NUMBER=8600 0000 0000 0000
CARD_HOLDER=FAMILIYA ISM
DOC_PRICE=15000
FREE_DAILY_LIMIT=25
RECEIPT_MAX_AGE_HOURS=48
# Optional overrides
# CHAT_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash
# LITE_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.6-flash
# EMBED_MODEL=gemini-embedding-001
# Leave empty locally (long polling). Render sets RENDER_EXTERNAL_URL automatically.
# WEBHOOK_BASE_URL=
# WEBHOOK_SECRET=
